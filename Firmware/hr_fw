#include <bluefruit.h>
#include <Wire.h>
#include "MAX30105.h"

MAX30105 particleSensor;

// ── BLE: Servicio custom para mandar IR crudo ──
BLEService irService = BLEService(0x1234);
BLECharacteristic irCharacteristic = BLECharacteristic(0x5678);

void setup() {
  Serial.begin(115200);
  delay(1000);
  Serial.println("== hr-monitor: Iniciando ==");

  // ── Inicializar MAX30102 ──
  if (!particleSensor.begin(Wire, I2C_SPEED_FAST)) {
    Serial.println("ERROR: No se encontró el MAX30102.");
    while (1);
  }
  Serial.println("MAX30102 detectado.");

  particleSensor.setup();
  particleSensor.setPulseAmplitudeRed(0x0A);
  particleSensor.setPulseAmplitudeGreen(0);

  // ── Inicializar BLE ──
  Bluefruit.begin();
  Bluefruit.setName("XIAO-HRMonitor");
  Bluefruit.setTxPower(4);

  irService.begin();

  irCharacteristic.setProperties(CHR_PROPS_NOTIFY);
  irCharacteristic.setPermission(SECMODE_OPEN, SECMODE_NO_ACCESS);
  irCharacteristic.setFixedLen(4); // 4 bytes para un uint32
  irCharacteristic.begin();

  Bluefruit.Advertising.addFlags(BLE_GAP_ADV_FLAGS_LE_ONLY_GENERAL_DISC_MODE);
  Bluefruit.Advertising.addService(irService);
  Bluefruit.Advertising.addName();
  Bluefruit.Advertising.restartOnDisconnect(true);
  Bluefruit.Advertising.setInterval(32, 244);
  Bluefruit.Advertising.setFastTimeout(30);
  Bluefruit.Advertising.start(0);

  Serial.println("BLE activo. Esperando conexión...");
}

void loop() {
  long irValue = particleSensor.getIR();

  if (Bluefruit.connected()) {
    uint32_t ir = (uint32_t)irValue;
    irCharacteristic.notify((uint8_t*)&ir, 4);
  }

  Serial.print("IR=");
  Serial.println(irValue);

  delay(20); // ~50 muestras por segundo
}